# Profil LOCAL : code local, base de données locale.
#
# Ce fichier ne contient AUCUN secret : uniquement des références 1Password
# et des valeurs publiques. Il est versionné exprès.
#
# Attention : ne jamais écrire le préfixe de référence 1Password en clair dans
# un commentaire ici. `op inject` traite tout le fichier comme un gabarit et
# échoue sur une référence incomplète, même commentée.
#
# npm run env:pull   régénère .env.local depuis 1Password (une seule invite)
# npm run dev        lit .env.local, ne touche pas à 1Password (zéro invite)
#
# Profil alternatif : .env.op.prod (base de données de production)

# --- Base de données -------------------------------------------------------
# Postgres local, via docker compose (npm run db:up). Port 5433 pour ne pas
# entrer en conflit avec un autre Postgres déjà sur 5432.
DATABASE_URL="postgresql://ardoise:ardoise@localhost:5433/mon_ardoise"

# --- Authentification ------------------------------------------------------
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="op://Dev/mon-ardoise/BETTER_AUTH_SECRET"

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
# Redirect URI : http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="op://Dev/mon-ardoise/GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="op://Dev/mon-ardoise/GOOGLE_CLIENT_SECRET"

# --- Envoi d'e-mail --------------------------------------------------------
# Le rappel de retard part par Resend. La clé présente, un appel au cron depuis
# ce profil envoie de vrais e-mails, sur les données locales : c'est voulu, c'est
# le seul moyen de relire le message tel qu'il arrive. Sans clé, `sendEmail` se
# contente d'une ligne de log.
RESEND_API_KEY="op://Dev/mon-ardoise/RESEND_API_KEY"
MAIL_FROM="op://Dev/mon-ardoise/MAIL_FROM"

# --- Cron ------------------------------------------------------------------
# Ce que Vercel envoie en Bearer sur /api/cron/*. Sans lui la route répond 404,
# donc rien ne se teste en local.
CRON_SECRET="op://Dev/mon-ardoise/CRON_SECRET"
