# ⚠ Profil PROD : code local, base de données de PRODUCTION.
#
# Tout ce que tu fais ici touche les vraies données. Pas de docker compose :
# la base est distante.
# Lancement : npm run prod   (port 3001, hôte 127.0.0.1)
#
# Pourquoi 127.0.0.1 et pas localhost : les cookies ignorent le port
# (RFC 6265). localhost:3000 et localhost:3001 partageraient le même pot de
# cookies, donc la session prod et la session locale s'écraseraient l'une
# l'autre. 127.0.0.1 est un hôte distinct -> sessions isolées. Et Google
# accepte http:// sur les adresses loopback, donc rien à configurer.

# --- Base de données -------------------------------------------------------
# Neon, connection string "pooled" depuis https://console.neon.tech
# sslmode=verify-full et non require : pg va changer la sémantique de
# `require`, verify-full fixe explicitement la vérification du certificat.
DATABASE_URL="op://Dev/mon-ardoise/DATABASE_URL_PROD"

# --- Authentification ------------------------------------------------------
BETTER_AUTH_URL="http://127.0.0.1:3001"
# Même secret que le profil local : il ne sert qu'à signer les cookies. Une
# session créée ici est une vraie ligne dans la base de prod, mais le cookie
# signé localement n'a pas à être valide côté déploiement.
#
# Si ton déploiement utilise un secret distinct et que tu veux réutiliser ses
# sessions, ajoute un champ BETTER_AUTH_SECRET_PROD à l'item 1Password et
# change le nom du champ ci-dessous. Ne laisse pas une référence en
# commentaire : `op inject` résout tout le fichier, commentaires inclus, et
# échoue si le champ n'existe pas.
BETTER_AUTH_SECRET="op://Dev/mon-ardoise/BETTER_AUTH_SECRET"

# Même client OAuth que le profil local ; il faut juste ajouter la redirect URI
# http://127.0.0.1:3001/api/auth/callback/google dans Google Cloud Console.
GOOGLE_CLIENT_ID="op://Dev/mon-ardoise/GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="op://Dev/mon-ardoise/GOOGLE_CLIENT_SECRET"

# --- Alternative : hostname explicite plutôt que 127.0.0.1 -----------------
# Plus lisible dans la barre d'adresse (on voit qu'on est sur la prod), mais
# demande deux choses en plus : une ligne dans
# C:\Windows\System32\drivers\etc\hosts (admin) :
#     127.0.0.1 prod.ardoise.test
# et du HTTPS, parce que Google n'autorise http:// que sur localhost/loopback.
# `next dev --experimental-https` génère un certificat local via mkcert.
# Pour basculer : commente les deux lignes 127.0.0.1 ci-dessus, décommente
# celle-ci, et ajoute --experimental-https au script "prod".
# BETTER_AUTH_URL="https://prod.ardoise.test:3001"
