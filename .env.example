# --- Base de données -------------------------------------------------------
# Deux options, une seule active à la fois.

# Postgres local, via docker compose (npm run db:up). Port 5433 pour ne pas
# entrer en conflit avec un autre Postgres déjà sur 5432.
DATABASE_URL="postgresql://ardoise:ardoise@localhost:5433/mon_ardoise"

# Neon, connection string "pooled" depuis https://console.neon.tech
# sslmode=verify-full et non require : pg va changer la sémantique de `require`,
# verify-full fixe explicitement la vérification du certificat.
# DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/mon_ardoise?sslmode=verify-full"

# --- Authentification ------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET="remplace-moi"
BETTER_AUTH_URL="http://localhost:3000"

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Envoi d'e-mail --------------------------------------------------------
# Facultatif. Sans clé, rien ne part et le rappel de retard se contente d'une
# ligne de log : un poste de développement n'a pas de compte d'envoi.
# Clé API sur https://resend.com > API Keys
RESEND_API_KEY=""
MAIL_FROM="Mon Ardoise <ardoise@exemple.be>"

# --- Cron ------------------------------------------------------------------
# Le secret que Vercel envoie en Bearer sur /api/cron/*. Sans lui, la route
# répond 404 : une URL qui envoie des e-mails ne s'ouvre pas par défaut.
# openssl rand -base64 32
CRON_SECRET=""
